{
  "name": "kitstak-app",
  "version": "0.0.1",
  "private": true,
  "description": "Kitstak: the operating system for 3PLs, manufacturers, and co-pack operations.",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "test": "pnpm --filter web test",
    "test:contract": "pnpm --filter web test:contract",
    "test:rls": "pnpm --filter web test:rls",
    "test:e2e": "pnpm --filter web test:e2e",
    "bundle-budget": "pnpm --filter web bundle-budget",
    "gen:types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_REF\" --schema public > apps/web/src/lib/database.types.ts"
  }
}
