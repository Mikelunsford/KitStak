# Kitstak SPA environment template. Copy to apps/web/.env.local and fill
# in real values. Do NOT commit a populated .env. .gitignore allows this
# .env.example file but blocks every other .env shape.

# Supabase project URL. Public; embedded in every API call.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon key. Public; designed for client-side use. RLS is the
# authority for tenant isolation.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Deploy environment label. Used by error boundaries and audit log
# annotations. Values: local, preview, staging, production.
VITE_APP_ENV=local

# Public SPA URL. Used to construct absolute links in PDFs and emails.
VITE_APP_URL=http://localhost:5173

# F-Wave5-CO-02: PostHog analytics. Both vars are optional; if
# VITE_POSTHOG_KEY is absent the analytics module stays in no-op
# posture (no network, no warnings). PostHog public project keys are
# frontend-safe.
VITE_POSTHOG_KEY=phc_your_public_project_key
# Host defaults to PostHog Cloud US when unset. Override to Cloud EU
# (https://eu.i.posthog.com) or a self-hosted domain as needed.
VITE_POSTHOG_HOST=https://us.i.posthog.com

# F-Wave5-CO-01 / F-Wave3-OBS-01 (SPA portion): Sentry SaaS error and
# performance capture. All four vars are optional; if VITE_SENTRY_DSN
# is absent at build time the Sentry module stays in no-op posture
# and the @sentry/react chunk is tree-shaken out of the bundle.
# Sentry DSNs are frontend-safe by design (rate-limited per project).
VITE_SENTRY_DSN=https://your_public_key@oXXXXXX.ingest.sentry.io/XXXXXXX
# Environment label sent on every event. Defaults to VITE_APP_ENV.
# Set explicitly only if the Sentry-side label needs to diverge.
VITE_SENTRY_ENVIRONMENT=production
# Performance trace sample rate, 0.0 to 1.0. Defaults to 0.1 (10
# percent) in code. Dial up during a launch window; dial down for
# sustained operation.
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Session replay sample rate, 0.0 to 1.0. Defaults to 0.0 in code so
# only replays-on-error are captured (the on-error rate is hard-wired
# to 1.0). Set above 0 to baseline-record sessions.
VITE_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0.0

# F-Wave9-SENTRY-SOURCEMAPS-01: build-time only. These three vars feed
# `@sentry/vite-plugin` so production source maps upload to Sentry and
# Sentry deminifies stack traces server-side. They MUST NOT carry a
# `VITE_` prefix because Vite's `define` step only substitutes
# `VITE_*` env vars into the SPA bundle. The auth token is a write
# secret; leaking it would let anyone publish arbitrary releases under
# the project. The contract test at
# `apps/web/test/regression/sentry-auth-leak.test.ts` scans `dist/`
# after every build and fails if any chunk contains the literal
# `sentry_auth` substring. Rotate `SENTRY_AUTH_TOKEN` annually.
# When `SENTRY_AUTH_TOKEN` is unset the plugin no-ops; the build still
# succeeds and ships a bundle, but stack traces in Sentry stay
# minified.
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxx
