# Kitstak Edge Function secrets template.
#
# Edge-function secrets are SERVER-SIDE only. Set them via:
#
#   supabase secrets set KEY=value
#
# or in the Supabase dashboard under Project Settings -> Edge Functions ->
# Secrets. They are injected into the Deno runtime via `Deno.env.get(KEY)`.
#
# This file documents the names. Do NOT commit real values.

# Supabase service-role credentials. Injected automatically by the
# platform when the function is deployed via `supabase functions deploy`;
# listed here for local-dev reference.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# F-Wave5-CO-01-EDGE-01: Sentry SaaS error capture for the Edge Function
# bundle. Optional; when absent, the central wrapper at
# supabase/functions/_shared/sentry.ts stays in no-op posture (no fetch,
# no module side-effects, zero per-request overhead).
#
# WARNING: this var is SERVER-SIDE ONLY. It is NOT a `VITE_` var and
# MUST NEVER be exposed to the SPA bundle.
#
#   - The SPA carries its own DSN at `VITE_SENTRY_DSN` (a public,
#     rate-limited project key, frontend-safe by design).
#   - This Edge-side DSN should be a SEPARATE Sentry project so error
#     classes (browser-tree errors vs. server-side route errors) stay
#     visually distinct in the Sentry UI. Operator may consolidate into
#     one project later by changing only this DSN; the SPA DSN remains
#     untouched.
#   - Do NOT reuse the SPA's DSN unless you explicitly want both error
#     streams in one Sentry project. Server-side DSNs are not subject
#     to the same rate-limit envelope as public project keys.
SENTRY_DSN=https://your_server_key@oXXXXXX.ingest.sentry.io/XXXXXXX

# Optional environment label sent on every Sentry event. Defaults to
# the Supabase functions region claim when unset.
SENTRY_ENVIRONMENT=production
